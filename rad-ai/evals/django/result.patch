diff --git a/django/utils/text.py b/django/utils/text.py
index 6297e4b..7ceb1a5 100644
--- a/django/utils/text.py
+++ b/django/utils/text.py
@@ -468 +468 @@ def unescape_string_literal(s):
-def slugify(value, allow_unicode=False):
+def slugify(value, allow_unicode=False, *, max_length=None):
@@ -473 +473,3 @@ def slugify(value, allow_unicode=False):
-    trailing whitespace, dashes, and underscores.
+    trailing whitespace, dashes, and underscores. If 'max_length' is supplied,
+    limit the result to that many code points, stripping trailing dashes and
+    underscores after truncation.
@@ -474,0 +477,5 @@ def slugify(value, allow_unicode=False):
+    if max_length is not None:
+        if isinstance(max_length, bool) or not isinstance(max_length, int):
+            raise TypeError("max_length must be a positive integer.")
+        if max_length <= 0:
+            raise ValueError("max_length must be a positive integer.")
@@ -485 +492,4 @@ def slugify(value, allow_unicode=False):
-    return re.sub(r"[-\s]+", "-", value).strip("-_")
+    value = re.sub(r"[-\s]+", "-", value).strip("-_")
+    if max_length is not None:
+        value = value[:max_length].rstrip("-_")
+    return value
diff --git a/docs/ref/utils.txt b/docs/ref/utils.txt
index ae5d524..01c6492 100644
--- a/docs/ref/utils.txt
+++ b/docs/ref/utils.txt
@@ -940 +940 @@ appropriate entities.
-.. function:: slugify(value, allow_unicode=False)
+.. function:: slugify(value, allow_unicode=False, *, max_length=None)
@@ -965,0 +966,19 @@ appropriate entities.
+    The keyword-only ``max_length`` argument limits the normalized slug to at
+    most that many Unicode code points. Any trailing hyphens or underscores
+    exposed by truncation are removed, so the result may be shorter than
+    ``max_length``. The default, ``None``, leaves the length unlimited.
+    Otherwise, ``max_length`` must be a positive integer, excluding booleans.
+    Other types raise :exc:`TypeError`; zero or negative integers raise
+    :exc:`ValueError`.
+
+    .. code-block:: pycon
+
+        >>> slugify("Hello World", max_length=6)
+        'hello'
+        >>> slugify("你好 World", allow_unicode=True, max_length=4)
+        '你好-w'
+
+    .. versionchanged:: 6.2
+
+        The ``max_length`` argument was added.
+
