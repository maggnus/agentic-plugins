  "historical_acceptance_relaxation": {
    "record_field": "historical_acceptance",
    "incomplete_metadata_field": "historical_acceptance_metadata_incomplete",
    "time_record_field": "historical_time_record",
    "meaning": "An accepted card imported from a pre-tree record may omit started_at, and may omit both accepted_at and closure_commit only when historical_acceptance_metadata_incomplete is explicitly true. That exception requires both fields to be empty, so it records their joint absence in the source rather than permitting an accidental omission. Imported cards are exempt from the wave plan-review gate, because they predate the plan."
  },
  "escalation_decisions": {
    "bounded_retry": {
      "extends_loop": true,
      "meaning": "the CTO grants the bounded second budget; the loop resumes with an exact acceptance condition"
    },
    "independent_review": {
      "extends_loop": true,
      "meaning": "a replacement reviewer inspects inside the granted budget"
    },
    "accept_with_corrections": {
      "extends_loop": false,
      "meaning": "the outcome lands; named corrections are made before merge and read as a delta"
    },
    "split": {
      "extends_loop": false,
      "meaning": "the settled part lands; the unresolved part becomes its own node"
    },
    "stop": {
      "extends_loop": false,
      "meaning": "the gate is named and the node blocks or is withdrawn"
    }
  }
